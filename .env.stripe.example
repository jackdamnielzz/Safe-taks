# =============================================================================
# STRIPE PAYMENT INTEGRATION - Environment Variables
# =============================================================================
# Copy these variables to your .env.local file and fill in the actual values
# Also add them to Vercel Environment Variables and GitHub Secrets
#
# Documentation: See STRIPE_INTEGRATION_COMPLETE.md for full setup guide
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe API Keys
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
# Use TEST keys for development, LIVE keys for production

# Server-side secret key (NEVER expose to client)
STRIPE_SECRET_KEY=sk_test_51...

# Client-side publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# -----------------------------------------------------------------------------
# Stripe Webhook Configuration
# -----------------------------------------------------------------------------
# Get this from: https://dashboard.stripe.com/webhooks
# Create webhook endpoint: https://your-app.vercel.app/api/stripe/webhook
# Subscribe to events: checkout.session.completed, customer.subscription.*,
#                      invoice.payment_succeeded, invoice.payment_failed

STRIPE_WEBHOOK_SECRET=whsec_...

# For local testing with Stripe CLI:
# 1. Run: stripe listen --forward-to localhost:3000/api/stripe/webhook
# 2. Copy the webhook signing secret from the output
# 3. Add it here as STRIPE_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# Stripe Price IDs
# -----------------------------------------------------------------------------
# Create products and prices in Stripe Dashboard
# https://dashboard.stripe.com/products
#
# For each tier, create:
# 1. A product (e.g., "SafeWork Pro - Starter")
# 2. Two prices: monthly and yearly recurring
# 3. Add metadata: tier=starter (or professional/enterprise)
# 4. Copy the price IDs (price_...) here

# Starter Plan (€49/month, €490/year)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...

# Professional Plan (€149/month, €1490/year)
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...

# Enterprise Plan (€499/month, €4990/year)
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Used for Stripe redirect URLs (success/cancel)
# Development: http://localhost:3000
# Production: https://your-app.vercel.app

NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# SETUP CHECKLIST
# =============================================================================
#
# [ ] 1. Create Stripe account at https://stripe.com
# [ ] 2. Get API keys from https://dashboard.stripe.com/apikeys
# [ ] 3. Create 3 products (Starter, Professional, Enterprise)
# [ ] 4. Create 6 prices (monthly + yearly for each tier)
# [ ] 5. Copy all price IDs to this file
# [ ] 6. Create webhook endpoint in Stripe Dashboard
# [ ] 7. Copy webhook signing secret to this file
# [ ] 8. Configure Customer Portal in Stripe Dashboard
# [ ] 9. Enable payment methods: Card, iDEAL, SEPA
# [ ] 10. Test locally with Stripe CLI
# [ ] 11. Add all variables to Vercel Environment Variables
# [ ] 12. Add all variables to GitHub Secrets (for CI/CD)
#
# =============================================================================
# TESTING
# =============================================================================
#
# Local Testing:
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 2. Login: stripe login
# 3. Forward webhooks: stripe listen --forward-to localhost:3000/api/stripe/webhook
# 4. Use test cards: 4242 4242 4242 4242 (success)
#
# Test Events:
# - stripe trigger checkout.session.completed
# - stripe trigger customer.subscription.created
# - stripe trigger invoice.payment_succeeded
# - stripe trigger invoice.payment_failed
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# - NEVER commit actual API keys to version control
# - Use TEST keys for development
# - Use LIVE keys only in production
# - Rotate keys if compromised
# - Restrict API key permissions in Stripe Dashboard
# - Enable webhook signature verification (always on)
# - Monitor webhook delivery in Stripe Dashboard
#
# =============================================================================